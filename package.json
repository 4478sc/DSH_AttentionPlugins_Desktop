{
  "name": "dsh-attention-toast",
  "version": "0.2.2-desktop.15",
  "private": false,
  "type": "module",
  "description": "Desktop edition of attention-plugins for DeepSeek Harness: task-priority notifications delivered as bottom-right desktop toasts (Windows WPF / Linux GTK) instead of sounds or browser notifications.",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "test": "node tests/manifest.test.mjs && node tests/approval-ledger.test.mjs && node tests/toast-registry.test.mjs && node tests/host-events.test.mjs && node tests/client-logic.test.mjs",
    "smoke:toast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-toast.ps1",
    "pack": "npm pack"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/4478sc/DSH_AttentionPlugins_Desktop"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "notification",
    "toast",
    "desktop",
    "attention"
  ],
  "license": "MIT"
}
